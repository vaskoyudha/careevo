# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Template env boleh di-commit: ia hanya memuat nama variabel dan cara
# membuat nilainya, tanpa satu pun secret sungguhan.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data (file-based resume store: structured JSON + uploaded CV/portfolio)
/.data/

# playwright mcp tooling artifacts
/.playwright-mcp/

# agent run artifacts
/.omo/
/.omc/

# runtime data store (kursus & kurikulum tersimpan)
/data/

# berkas unggahan runtime (cover kursus, PDF materi)
/public/uploads/

# dokumen kerja proposal lomba (lokal, tidak dipublikasikan di repositori)
/pendahuluan.md

