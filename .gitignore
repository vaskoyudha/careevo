# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Template env boleh di-commit: ia hanya memuat nama variabel dan cara
# membuat nilainya, tanpa satu pun secret sungguhan.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data (file-based resume store: structured JSON + uploaded CV/portfolio)
/.data/

# career-ops: /engine/ is the vendored MIT core and IS committed (it is spawned
# at runtime). This is only the original upstream clone kept for reference —
# engine/ came from it, but the clone itself is not a Careevo source tree.
/career-ops/

# playwright mcp tooling artifacts
/.playwright-mcp/

# agent run artifacts
/.omo/
/.omc/

# python bytecode (scripts/generate-hero-backdrop.py is committed; its cache is not)
__pycache__/
*.py[cod]

# runtime data store (kursus & kurikulum tersimpan)
/data/

# berkas unggahan runtime (cover kursus, PDF materi)
/public/uploads/

# SiJago (the vendored DeepTutor app): source is committed, build/deps are not
/features/sijago/node_modules/
/features/sijago/.next/
/features/sijago/.turbo/
/features/sijago/dist/
/features/sijago/test-results/
/features/sijago/playwright-report/

# dokumen kerja proposal lomba (lokal, tidak dipublikasikan di repositori)
/pendahuluan.md

