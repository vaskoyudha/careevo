# Environment produksi Careevo — TEMPLATE, bukan file yang dipakai server.
#
# Salin ke VPS sebagai `.env.production` (atau pakai sebagai entri secret
# manager), lalu isi nilainya. **Jangan commit hasilnya**; hanya template ini
# yang masuk repo.
#
# Perbedaan dari `.env.example`:
#
#   .env.example            -> `npm run dev` di laptop, nilai boleh kosong
#   .env.production.example -> VPS, hampir semua WAJIB diisi
#
# Yang membuat produksi tidak bisa "jalan setengah": `src/instrumentation.ts`
# memanggil `verifikasiKonfigurasiSecret()` sekali saat start, jadi
# `SESSION_SECRET`/`ATTESTATION_SECRET` yang salah **refus start**, bukan diam
# diam memakai nilai dev.
#
# Google OAuth berbeda: kredensial yang kosong **tidak** memblokir start. Tombol
# "Masuk dengan Google" hanya mengarahkan balik ke
# `/masuk?error=oauth_not_configured` — dan itu kode milik Careevo sendiri,
# bukan error dari Google. Gejalanya persis yang Anda lihat di VPS, jadi bagian
# Google di bawah tidak dikomentari: nilainya harus diisi.

# --- Wajib: identitas dan database -------------------------------------------

# `NODE_ENV=production` mengaktifkan seluruh gate produksi (cek secret, tolak
# fallback kredensial dev, dan lainnya). Jangan memakai nilai lain di sini.
NODE_ENV=production

# Di produksi `DATABASE_URL` WAJIB ada. Kosong = proses refuse start
# (`ambilUrlDatabase` melempar `DatabaseUrlError`), bukan memakai kredensial dev.
# Pakai managed PostgreSQL, bukan postgres di dalam compose yang sama.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/careevo?sslmode=require

# --- Wajib: secret tanda tangan (HMAC) ---------------------------------------

# Minimal 32 karakter, tidak boleh menyerupai nilai dev maupun kata template.
# Buat dengan:
#   openssl rand -base64 48
# Server menolak start bila kosong, memakai nilai dev, memakai kata seperti
# "changeme" atau "ganti", atau terlalu pendek.
SESSION_SECRET=GANTI-dengan-hasil-openssl-rand-base64-48
ATTESTATION_SECRET=GANTI-dengan-hasil-openssl-rand-base64-48

# --- Google OAuth ------------------------------------------------------------
#
# Client ID + Client Secret dari Google Cloud Console (OAuth 2.0 client tipe
# **Web application**). Ambil dari baris "Web" di detail client, bukan baris
# "Desktop" atau "iOS" — client type harus cocok dengan alur yang dipakai.
#
# Kalau kosong, `/api/auth/google` mengarahkan ke
# `/masuk?error=oauth_not_configured`. Kode itu milik Careevo, bukan dari
# Google, jadi jangan buru-buru mengira Google yang menolak.
GOOGLE_CLIENT_ID=49756277498-ju1gtbqcghbvcvnopipbq410vb1kciqj.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GANTI-dengan-client-secret-asli-dari-google-console

# **Wajib di produksi.** Bila kosong, `redirect_uri` diturunkan dari host
# request — dan di belakang reverse proxy host itu bisa `localhost:3000`, yang
# tidak ada di daftar Google. Gejalanya: `Error 400: redirect_uri_mismatch`
# padahal URI-nya sudah terdaftar.
#
# Harus **persis** sama dengan "Authorized redirect URI" di Google Cloud
# Console, termasuk `https://` dan tanpa garis miring di akhir.
GOOGLE_REDIRECT_URI=https://careevo.my.id/api/auth/callback/google

# --- Reverse proxy (wajib bila Nginx/Caddy berada di depan app) ---------------
#
# Tanpa ini, `request.url` berisi host internal container sehingga alamat
# kembali menunjuk `localhost:3000` — persis yang terlihat di address bar.
CAREEVO_TRUST_PROXY_HEADERS=1

# Hanya bila proxy benar-benar menimpa `x-real-ip` (dipakai untuk keying rate
# limit). Jangan aktifkan bila klien bisa menyuntik header itu sendiri.
# CAREEVO_TRUST_REAL_IP_HEADER=1

# --- Rate limit (wajib di produksi) -------------------------------------------

# Kosong = server menolak melayani. URL harus https dan bisa di-parse.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# --- Runner kode C++ (wajib untuk tombol Jalankan) ---------------------------

# Harus **sama persis** dengan nilai di proses runner; kalau tidak, tombol
# Jalankan selalu dijawab "Layanan eksekusi sedang tidak tersedia".
# openssl rand -hex 32
# CAREEVO_RUNNER_SECRET=

# --- AI Mastery (opsional) ---------------------------------------------------

# `AI_MASTERY_API_URL` = basis **API** FastAPI (bukan basis web). Kosong berarti
# tidak ada bridging: tombol tetap tampil, konteks kursus tidak ikut.
# AI_MASTERY_API_URL=http://127.0.0.1:8011
# AI_MASTERY_WEB_URL=http://127.0.0.1:3790

# --- LLM (opsional) ----------------------------------------------------------
# CAREEVO_LLM_BASE_URL=
# CAREEVO_LLM_MODEL=
# CAREEVO_LLM_API_KEY=

# --- Evaluasi A-H (opsional) -------------------------------------------------
# GEMINI_API_KEY=

# --- Jangan aktifkan di produksi ---------------------------------------------
#
# `DEMO_MODE=1` hanya untuk `npm run dev` lokal. Guard di
# `src/lib/config/environment.ts` mensyaratkan `NODE_ENV=development` **dan**
# nilai tepat `1`, jadi di produksi baris ini tidak akan aktif. Tetap tidak
# boleh di sini karena kredensial demo itu dipublikasikan: menyalinnya ke env
# produksi hanya menambah satu jalan untuk membocorkan.
# DEMO_MODE=1
